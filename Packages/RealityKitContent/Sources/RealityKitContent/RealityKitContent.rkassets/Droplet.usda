#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.100.6)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "CheckerMat01"
    {
        asset inputs:Checker = @Textures/checker-black.png@ (
            customData = {
                dictionary realitykit = {
                    float2 positionInSubgraph = (260.25, 27.5)
                    int stackingOrderInSubgraph = 4
                }
            }
        )
        color3f inputs:Color = (0.99942404, 0.9855537, 0) (
            colorSpace = "srgb_texture"
            customData = {
                dictionary realitykit = {
                    float2 positionInSubgraph = (490.75, 519.78125)
                    int stackingOrderInSubgraph = 7
                }
            }
        )
        float2 inputs:UV_Scale = (5, 5) (
            customData = {
                dictionary realitykit = {
                    float2 positionInSubgraph = (70.25, 304.78125)
                    int stackingOrderInSubgraph = 14
                }
            }
        )
        token outputs:mtlx:surface.connect = </Root/CheckerMat01/PreviewSurface.outputs:out>
        token outputs:realitykit:vertex
        token outputs:surface.connect = None
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (1112.75, 342.96094)

        def Shader "DefaultSurfaceShader" (
            active = false
        )
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (1, 1, 1)
            color3f inputs:diffuseColor.connect = </Root/Cube/DefaultMaterial/diffuseColor.outputs:rgb>
            float inputs:roughness = 0.75
            token outputs:surface
        }

        def Shader "diffuseColor"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @Textures/checker-black.png@
            float2 inputs:st.connect = </Root/CheckerMat01/diffuseColor/TexCoordReader.outputs:result>
            color3f outputs:rgb

            def Shader "TexCoordReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Root/CheckerMat01.inputs:frame:stPrimvarName>
                float2 outputs:result
            }
        }

        def Shader "PreviewSurface"
        {
            uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
            color3f inputs:diffuseColor.connect = </Root/CheckerMat01/Multiply.outputs:out>
            float inputs:metallic
            float inputs:opacity
            float inputs:roughness
            token outputs:out
            float2 ui:nodegraph:node:pos = (871, 342.96094)
        }

        def Shader "TiledImage"
        {
            uniform token info:id = "ND_tiledimage_color3"
            asset inputs:file.connect = </Root/CheckerMat01.inputs:Checker>
            string inputs:filtertype
            float2 inputs:realworldimagesize
            float2 inputs:realworldtilesize
            float2 inputs:texcoord
            float2 inputs:uvoffset
            float2 inputs:uvtiling.connect = </Root/CheckerMat01/Dot.outputs:out>
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (490.75, 166.14062)
            int ui:nodegraph:node:stackingOrder = 3
        }

        def Shader "Multiply"
        {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1.connect = </Root/CheckerMat01/TiledImage.outputs:out>
            color3f inputs:in2 = (1, 0.5409764, 0.8473143) (
                colorSpace = "srgb_texture"
            )
            color3f inputs:in2.connect = </Root/CheckerMat01.inputs:Color>
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (689.5, 342.96094)
            int ui:nodegraph:node:stackingOrder = 6
        }

        def Shader "Dot"
        {
            uniform token info:id = "ND_dot_vector2"
            float2 inputs:in.connect = </Root/CheckerMat01.inputs:UV_Scale>
            float2 outputs:out
            float2 ui:nodegraph:node:pos = (260.25, 304.78125)
            int ui:nodegraph:node:stackingOrder = 12
        }
    }

    def Xform "DirectionalLight" (
        customData = {
            float3 rotationEulerHint = (-0.53564155, 0, 0)
        }
    )
    {
        float2 ui:nodegraph:node:pos = (20, 20)
